class Library:

    def __init__ (self):
        self.books_amount = 20
        print("Books amount is: ", self.books_amount)
        self.books_names = [
        "Atomic Habits",
        "Python",
        "C++",
        "Archeology",
        "Psychology",
        "C#",
        "Java",
        "Biology",
        "Java script",
        "Holy C",
        "HTML",
        "CSS",
        "SQL",
        "Django",
        "Git",
        "Linux",
        "Computer Science",
        "PHP",
        "SQl",
        "Maths",
        "Physics"]


        self.books_amount = len(self.books_names)
        print("Now Books amount is: ", self.books_amount)
        self.books_taken = []
        self.books_returned = []
        self.member_name = ""
        self.taken_book = ""
        self.days = 0

    def add_book(self, book):
        self.books_names.append(book)
        self.books_amount = len(self.books_names)


    def available_books(self):
            print("Available books:")
            for book in self.books_names:
                print('->', book)


    def set_member_name(self, name):
            self.member_name = name
            print(f"The name of Library member is {name}")

    def set_books_taken(self, books_taken, books_taken_names):
            self.books_taken = []
            print(f"The books taken is: {books_taken}")

            for book in books_taken_names:
                book = book.title()
                self.books_taken.append(book)
                self.books_names.remove(book)
                print(f"Remaining Books in Library {self.books_names}")
                print("Book taken: ", '->',book)

    def set_days(self, days):
            self.days = days
            print("The days taken is: ", days)

    def set_books_returned(self, books_returned):
            self.books_returned = []
            for book in books_returned:
                book = book.title()
                if book in self.books_taken:
                    self.books_taken.remove(book)
                    self.books_names.append(book)
                    print("Book returned: ", '->',book)
                else:
                    print(f"{book} book was not taken")
